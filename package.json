{
    "name": "seanmcn-web-frontend",
    "description": "Frontend for seanmcn.com",
    "version": "3.0.0",
    "author": "Seán McNamara",
    "private": true,
    "engines": {
        "npm": ">=10.9.0",
        "node": ">=24 <25"
    },
    "scripts": {
        "build": "astro build",
        "clean": "rimraf dist .astro node_modules/.astro",
        "dev": "astro dev",
        "dev:lan": "astro dev --host 0.0.0.0",
        "develop": "npm run dev",
        "favicons": "node scripts/fetch-favicons.mjs",
        "image": "node scripts/auto-featured-image.mjs",
        "image:manual": "node scripts/generate-featured-image.mjs",
        "lint": "npm run lint:js && npm run lint:css",
        "lint:css": "stylelint \"src/**/*.scss\"",
        "lint:js": "eslint src tests scripts astro.config.mjs playwright.config.js",
        "format": "eslint src --fix",
        "preview": "astro preview",
        "start": "npm run dev",
        "schema": "node scripts/frontmatter-schema.mjs",
        "taxonomy": "node scripts/list-taxonomy.mjs",
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "node --test 'tests/unit/*.test.mjs'",
        "test:e2e": "playwright test",
        "test:e2e:ci": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "dependencies": {
        "@astrojs/markdown-satteri": "^0.4.2",
        "@astrojs/mdx": "^8.0.2",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "astro": "^7.3.5",
        "fuse.js": "^7.1.0",
        "gray-matter": "^4.0.3",
        "mermaid": "^12.2.0",
        "node-emoji": "^2.2.0",
        "reading-time": "^1.5.0",
        "sass": "^1.98.0",
        "sharp": "^0.35.4",
        "shiki": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "eslint": "^10.13.0",
        "eslint-config-google": "^0.14.0",
        "globals": "^17.13.0",
        "rimraf": "^6.1.3",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0"
    },
    "license": "MIT"
}
