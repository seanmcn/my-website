{
    "name": "seanmcn-web-frontend",
    "description": "Frontend for seanmcn.com",
    "version": "3.0.0",
    "author": "Seán McNamara",
    "private": true,
    "engines": {
        "npm": ">=10.9.0",
        "node": ">=22.12 <23"
    },
    "scripts": {
        "build": "astro build",
        "clean": "rimraf dist .astro node_modules/.astro",
        "dev": "astro dev",
        "dev:lan": "astro dev --host 0.0.0.0",
        "develop": "npm run dev",
        "favicons": "node scripts/fetch-favicons.mjs",
        "lint": "npm run lint:js && npm run lint:css",
        "lint:css": "stylelint \"src/**/*.scss\"",
        "lint:js": "eslint src tests scripts astro.config.mjs playwright.config.js --ext .js,.jsx,.mjs",
        "format": "eslint src --ext .js,.jsx,.mjs --fix",
        "post:create": "plop --plopfile .plop/plopfile.js",
        "preview": "astro preview",
        "start": "npm run dev",
        "taxonomy": "node scripts/list-taxonomy.mjs",
        "test": "playwright test",
        "test:e2e": "playwright test",
        "test:e2e:ci": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "dependencies": {
        "@astrojs/markdown-satteri": "^0.4.2",
        "@astrojs/mdx": "^8.0.2",
        "@astrojs/react": "^7.0.0",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "astro": "^7.3.5",
        "fuse.js": "^7.1.0",
        "gray-matter": "^4.0.3",
        "match-sorter": "^6.3.0",
        "mermaid": "^11.14.0",
        "node-emoji": "^2.2.0",
        "prop-types": "^15.7.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-table": "^7.8.0",
        "reading-time": "^1.5.0",
        "sass": "^1.98.0",
        "sharp": "^0.35.4",
        "shiki": "^4.4.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "eslint": "^8.46.0",
        "eslint-config-google": "^0.14.0",
        "eslint-plugin-import": "^2.28.0",
        "eslint-plugin-jsx-a11y": "^6.7.1",
        "eslint-plugin-react": "^7.33.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "plop": "^3.1.2",
        "rimraf": "^5.0.1",
        "slugify": "^1.6.6",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0"
    },
    "license": "MIT"
}
