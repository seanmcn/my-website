---
import {Image, Picture} from 'astro:assets';
import Icon from '../components/icons/Icon.astro';
import Layout from '../layouts/Layout.astro';
import avatar from '../assets/images/emojis/250/wave.png';
import {IMAGE_SIZES} from '../lib/image-sizes.js';
import {
  excerpt,
  getLibraryItems,
  getLibraryMeta,
  getProjects,
  readingTimeMinutes,
} from '../lib/library.js';
import {
  formatDayMonth,
  formatItemDate,
  itemPath,
  readTimeLabel,
  slugToTitle,
} from '../utils/content.js';
import '../styles/pages/home.scss';

const DESCRIPTION = 'Software engineering & other rabbit holes. I build ' +
  'things, pull them apart, and try to make them better.';

function formatReadMinutes(minutes) {
  if (minutes >= 60) {
    return `${Math.floor(minutes / 60)}h ${minutes % 60}m`;
  }

  return `${minutes}m`;
}

/* A post's one-liner: its summary, else the opening of its body. */
function oneLine(item) {
  return item.data.summary || excerpt(item, 160);
}

const items = await getLibraryItems();
const {counts, readMinutes} = await getLibraryMeta();
const ofType = type => items.filter(item => item.data.type === type);
const posts = ofType('post').slice(0, 3);
const notes = ofType('note').slice(0, 3);
// A find is only news for a while, so the home page shows the last year's.
// The cut-off is the build date, as the page is static.
const findsSince = new Date();
findsSince.setFullYear(findsSince.getFullYear() - 1);
const finds = ofType('find')
    .filter(item => item.data.date >= findsSince)
    .slice(0, 5);
const projects = (await getProjects()).slice(0, 3);

const stats = [
  {label: 'Read time', value: formatReadMinutes(readMinutes)},
  {label: 'Posts', value: counts.post},
  {label: 'Notes', value: counts.note},
  {label: 'Finds', value: counts.find},
];
---
<Layout title="Seán McNamara" description={DESCRIPTION}>
  <div class="page-wrap home-page">
    <!--
      The design opens on the bio rather than a page title, so the h1 is
      carried for screen readers and skipped visually.
    -->
    <h1 class="visually-hidden">Seán McNamara</h1>
    <div class="home-page__row">
      <aside class="rail rail--bio home-bio">
        <div class="home-bio__top">
          <p class="home-bio__headline">
            I build things, pull them apart, and try to make them better.
          </p>
          <span class="home-bio__avatar-outer">
            <span class="home-bio__avatar" data-condense>
              <Image
                alt="Seán McNamara"
                fetchpriority="high"
                loading="eager"
                src={avatar}
                {...IMAGE_SIZES.homeAvatar}
              />
            </span>
          </span>
        </div>

        <div class="home-bio__body">
          <p class="home-bio__blurb">
            Usually software. Increasingly AI. Mostly me thinking out loud
            about what I&rsquo;m building, learning, or getting unnecessarily
            interested in.
          </p>
          <div class="home-bio__about-link">
            <a href="/about/">More about me →</a>
          </div>
          <div class="home-bio__role">
            <span class="home-bio__role-dot"></span>
            <span>
              Head of Engineering,{' '}
              <span class="home-bio__role-org">Axiom Maths</span>
            </span>
          </div>
        </div>

        <div class="home-bio__stats">
          {stats.map(stat => (
            <div class="home-bio__stat">
              <span>{stat.label}</span>
              <span class="home-bio__stat-value">{stat.value}</span>
            </div>
          ))}
        </div>
      </aside>

      <div class="home-page__main">
        <div class="home-page__split">
          <div>
            <div class="section-rule">
              <h2 class="section-rule__badge" style="background: var(--plum)">
                Latest posts
              </h2>
              <span class="section-rule__line"></span>
              <a
                class="section-rule__link"
                style="color: var(--plum)"
                href="/library/posts/"
              >
                All posts →
              </a>
            </div>

            <div class="home-lead">
              {posts.map((post) => {
                const {data} = post;
                const readTime = readTimeLabel(readingTimeMinutes(post.body));

                return (
                  <a class="home-lead__card" href={itemPath(data.slug)}>
                    <span class="home-lead__meta">
                      {data.category && (
                        <span class="home-lead__meta-cat">
                          <Icon name="category" size={11} />
                          {slugToTitle(data.category)}
                        </span>
                      )}
                      <span class="home-lead__meta-date">
                        <Icon name="calendar" size={11} />
                        {formatItemDate(data.date)}
                      </span>
                      {readTime && (
                        <span class="home-lead__meta-time">
                          <Icon name="clock" size={11} />
                          {readTime}
                        </span>
                      )}
                    </span>
                    <span class="home-lead__title">{data.title}</span>
                    <span class="home-lead__body">{oneLine(post)}</span>
                    {data.featured && (
                      <span class="home-lead__image">
                        {/*
                          AVIF first: the featured art has a transparent
                          background, which WebP stores losslessly, so the
                          WebP files run about twice the size.
                        */}
                        <Picture
                          alt=""
                          fallbackFormat="webp"
                          formats={['avif']}
                          loading="eager"
                          src={data.featured}
                          width={320}
                          {...IMAGE_SIZES.homeLead}
                        />
                      </span>
                    )}
                    {readTime && (
                      <span class="home-lead__time-row">
                        <Icon name="clock" size={11} />
                        {readTime}
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          </div>

          <div class="home-aside">
            <div>
              <div class="section-rule">
                <span class="section-rule__badge" style="background: var(--blue)">
                  Finds
                </span>
                <span class="section-rule__line"></span>
                <a
                  class="section-rule__link"
                  style="color: var(--blue)"
                  href="/library/finds/"
                >
                  All finds →
                </a>
              </div>
              <div class="home-aside__finds">
                {finds.length === 0 && (
                  <p class="home-aside__empty">
                    Nothing passed on lately. Older finds are under All finds.
                  </p>
                )}
                {finds.map(({data}) => {
                  const {day, monthShort} = formatDayMonth(data.date);

                  return (
                    <a class="home-aside__find" href={itemPath(data.slug)}>
                      <span class="home-aside__find-date">
                        {day} {monthShort}
                      </span>
                      <span class="home-aside__find-title">{data.title}</span>
                    </a>
                  );
                })}
              </div>
            </div>

            <div>
              <div class="section-rule">
                <span
                  class="section-rule__badge"
                  style="background: var(--amber); color: var(--amber-bg)"
                >
                  Notes
                </span>
                <span class="section-rule__line"></span>
                <a
                  class="section-rule__link"
                  style="color: var(--amber)"
                  href="/library/notes/"
                >
                  All notes →
                </a>
              </div>
              <div class="home-aside__notes">
                {notes.length === 0 && (
                  <p class="home-aside__empty">
                    Nothing filed yet. Shorter thoughts will land here.
                  </p>
                )}
                {notes.map((note) => {
                  const {data} = note;
                  const {day, monthShort, year} = formatDayMonth(data.date);

                  return (
                    <a class="home-aside__note" href={itemPath(data.slug)}>
                      <span class="home-aside__note-date">
                        {day} {monthShort} {year}
                      </span>
                      <span class="home-aside__note-title">{data.title}</span>
                      <span class="home-aside__note-excerpt">
                        {data.summary || excerpt(note, 130)}
                      </span>
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <section>
          <div class="section-rule">
            <h2 class="section-rule__badge">Things I&apos;ve built</h2>
            <span class="section-rule__line"></span>
            <a class="section-rule__link" href="/projects/">All projects →</a>
          </div>
          <div class="home-projects">
            {projects.map(({data}) => (
              <a class="home-projects__row" href={`/projects/${data.slug}/`}>
                {data.featured ? (
                  <span class="home-projects__thumb">
                    <Image
                      alt=""
                      fit="cover"
                      height={130}
                      position="top"
                      src={data.featured}
                      width={174}
                      {...IMAGE_SIZES.homeProject}
                    />
                  </span>
                ) : (
                  <span class="home-projects__thumb home-projects__thumb--blank"></span>
                )}
                <span>
                  <span class="home-projects__meta">
                    {data.language} · {data.date.getUTCFullYear()}
                  </span>
                  <span class="home-projects__line">
                    <span class="home-projects__name">{data.title}</span>
                    <span class="home-projects__blurb"> — {data.summary}</span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>
