---
import {Picture} from 'astro:assets';
import ElsewhereLinks from '../components/elsewhere/ElsewhereLinks.astro';
import FaviconLink from '../components/faviconLink/FaviconLink.astro';
import Layout from '../layouts/Layout.astro';
import {cardPath} from '../lib/social-cards.js';
import portrait from '../assets/images/portrait-transparent.png';
import '../styles/pages/about.scss';

const DESCRIPTION = 'Seán McNamara is Head of Engineering at Axiom Maths, ' +
  'with a background in backend platforms and product engineering.';

const SNAPSHOT = [
  {label: 'Location', value: 'London, UK'},
  {
    label: 'Outside work',
    value: 'Drawing, films, Brazilian Jiu-Jitsu, travelling and video games',
  },
  {label: 'Exploring', value: 'Agentic development'},
];

/*
 * Three levels of familiarity, shown as three weights: filled for daily, tinted
 * for often, outlined for things shipped but not lived in.
 */
const TOOLS = [
  {level: 'daily', name: 'Python'},
  {level: 'daily', name: 'PHP'},
  {level: 'daily', name: 'SQL'},
  {level: 'often', name: 'JavaScript'},
  {level: 'often', name: 'React'},
  {level: 'often', name: 'Vue'},
  {level: 'often', name: 'Bash'},
  {level: 'shipped', name: 'Flutter'},
  {level: 'shipped', name: 'Golang'},
  {level: 'shipped', name: 'Swift'},
  {level: 'shipped', name: 'C#'},
  {level: 'shipped', name: 'Unity'},
  {level: 'shipped', name: 'Godot'},
  {level: 'shipped', name: 'Java'},
];

// A paragraph is a string, or a list of strings and {href, text} links.
const SECTIONS = [
  {
    heading: 'How it started',
    paras: [
      'I got into web development the way a lot of people did: messing ' +
        'about with HTML and CSS, then moving on to PHP.',
      'My first paid work was freelancing in Kilkenny, Ireland (a great ' +
        'place to grow up, less so for a tech scene), building WordPress ' +
        'sites, custom plugins and themes, and ecommerce projects.',
    ],
  },
  {
    heading: 'Where it went next',
    paras: [
      [
        'Next I moved to Vancouver, which I loved, to join Library IT ' +
          'Services at the University of British Columbia. I worked on ',
        {href: 'https://open.library.ubc.ca/', text: 'Open Collections'},
        ', the library\'s public archive of digitised photos, books, ' +
          'newspapers, maps, videos and theses. We used Elasticsearch (a ' +
          'search engine) to make all of it searchable. The job also made ' +
          'me a lot better at explaining technical work to people who ' +
          'aren\'t developers.',
      ],
      [
        'Then I spent seven years at ',
        {href: 'https://kobas.co.uk/', text: 'Kobas'},
        ', which makes software for hospitality businesses. As lead ' +
          'engineer I was across pretty much everything, from the ',
        {
          href: 'https://www.kobas.co.uk/products/hospitality-epos/',
          text: 'EPoS',
        },
        ' (the tills staff take orders on) to ',
        {
          href: 'https://www.kobas.co.uk/products/stock-control/',
          text: 'stock control',
        },
        ', and the job was a mix of infrastructure, coding and product work.',
      ],
      [
        'From Kobas I moved to ',
        {href: 'https://bumble.com/', text: 'Bumble'},
        ', on the backend platform behind recommendations and discovery ' +
          '(deciding which profiles people see). The hard part was keeping ' +
          'latency low on a multi-region system handling a huge number of ' +
          'swipes a day. I added the ML team\'s ranking improvements without ' +
          'making anything slower, optimised the queries behind discovery, ' +
          'and fixed errors along the way.',
      ],
    ],
  },
  {
    heading: 'Where I am now',
    paras: [
      [
        'In 2026 I joined ',
        {href: 'https://axiommaths.com/', text: 'Axiom Maths'},
        ' as Head of Engineering. Axiom Maths partners with schools across ' +
          'England and Wales to help young people with the aptitude and ' +
          'appetite for maths realise their potential.',
      ],
      'My job is the technology behind the programmes: the systems and ' +
        'tooling our teams use, and the infrastructure that supports the ' +
        'curriculum, coaching and operations. It\'s the most mission-driven ' +
        'work I\'ve done.',
    ],
  },
  {
    heading: 'What I\'m exploring',
    paras: [
      'These days I\'m mostly writing Python, and spending a lot of time on ' +
        'newer developer workflows built around AI tooling, especially ' +
        'Claude and Codex. A big part of that is agentic development, where ' +
        'you hand an AI agent a task and it writes and runs the code itself. ' +
        'The trickiest bit right now is the verification layer: how far you ' +
        'let the agent go. Can it open a PR, merge one, deploy to production ' +
        'or change live data? I\'m working out where those lines sit, and ' +
        'bringing what I learn back to the teams I work with.',
    ],
  },
];

// Newest first in the rail, so the current role reads before the history.
const TIMELINE = [
  {
    org: 'Axiom Maths',
    role: 'Head of Engineering',
    years: '2026 – Present',
  },
  {
    org: 'Bumble',
    role: 'Senior Backend Engineer',
    years: '2023 – 2025',
  },
  {
    org: 'KOBAS',
    role: 'Lead Software Engineer',
    years: '2016 – 2023',
  },
  {
    org: 'The University of British Columbia',
    role: 'Programmer Analyst',
    years: '2015 – 2016',
  },
  {
    org: 'Self-employed',
    role: 'Freelance',
    years: 'Where it started',
  },
];
---
<Layout
  title="About Me - Seán McNamara"
  description={DESCRIPTION}
  image={cardPath('about')}
>
  <div class="page-wrap about-page">
    <div class="about-page__cols">
      <aside aria-label="Profile" class="rail rail--bio about-bio">
        <span class="about-bio__portrait-frame">
          <span class="about-bio__portrait" data-condense>
            {/* The rail is about 250px wide; 520 covers it on 2x screens. */}
            <Picture
              alt="Seán McNamara"
              fetchpriority="high"
              formats={['avif', 'webp']}
              loading="eager"
              src={portrait}
              width={520}
            />
          </span>
        </span>

        <div>
          <div class="eyebrow">About</div>
          <p class="about-bio__blurb">
            Backend engineer, now leading engineering at a maths charity.
          </p>
        </div>

        <div>
          {SNAPSHOT.map(row => (
            <div class="about-bio__snapshot">
              <span class="about-bio__snapshot-label">{row.label}</span>
              <span class="about-bio__snapshot-value">{row.value}</span>
            </div>
          ))}
        </div>

        <div>
          <div class="rail-heading about-bio__tools-heading">
            Languages &amp; tools
          </div>
          <div class="about-bio__tools">
            {TOOLS.map(tool => (
              <span class={`about-bio__tool about-bio__tool--${tool.level}`}>
                {tool.name}
              </span>
            ))}
          </div>
          <div class="about-bio__key">
            <span class="about-bio__key-item">
              <span class="about-bio__swatch about-bio__swatch--daily"></span>
              Daily
            </span>
            <span class="about-bio__key-item">
              <span class="about-bio__swatch about-bio__swatch--often"></span>
              Often
            </span>
            <span class="about-bio__key-item">
              <span class="about-bio__swatch about-bio__swatch--shipped"></span>
              Have shipped
            </span>
          </div>
        </div>
      </aside>

      <div class="about-page__main">
        <div class="sticky-bar about-page__bar">
          <h1 class="about-page__title">How I got here</h1>
        </div>

        <p class="about-page__lead">
          I&apos;m Head of Engineering at{' '}
          <FaviconLink href="https://axiommaths.com/">Axiom Maths</FaviconLink>,
          a maths charity. I live in London and have spent most of my career
          on the backend. Lately I&apos;ve been digging into agentic
          development with Claude and Codex.
        </p>

        {SECTIONS.map((section, index) => (
          <section class="about-section">
            <div class="about-section__head">
              <span class="about-section__num">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h2 class="about-section__heading">{section.heading}</h2>
            </div>
            {section.paras.map(para => (
              <p class="about-section__para">
                {[].concat(para).map(part => typeof part === 'string' ? part : (
                  <FaviconLink href={part.href}>{part.text}</FaviconLink>
                ))}
              </p>
            ))}
            {index < SECTIONS.length - 1 && (
              <div class="about-section__divider"></div>
            )}
          </section>
        ))}
      </div>

      <aside aria-label="Career timeline" class="right-rail about-timeline">
        <div>
          <div class="rail-heading about-timeline__heading">
            Where I&apos;ve worked
          </div>
          {TIMELINE.map(entry => (
            <div class="about-timeline__entry">
              <div class="about-timeline__years">{entry.years}</div>
              <div class="about-timeline__role">{entry.role}</div>
              <div class="about-timeline__org">{entry.org}</div>
            </div>
          ))}
        </div>
        <ElsewhereLinks />
      </aside>
    </div>
  </div>
</Layout>
