---
import {Image} from 'astro:assets';
import ContactForm from '../components/contactForm/ContactForm.astro';
import ElsewhereLinks from '../components/elsewhere/ElsewhereLinks.astro';
import Layout from '../layouts/Layout.astro';
import avatar from '../assets/images/emojis/250/wave.png';
import {getLibraryItems} from '../lib/library.js';
import {cardPath} from '../lib/social-cards.js';
import '../styles/pages/contact.scss';

const DESCRIPTION = 'Get in touch with Seán McNamara about software ' +
  'engineering roles, project ideas, collaborations, or questions about the ' +
  'articles published on this site.';

const EMAIL = 'me@seanmcn.com';

const RAIL = [
  {label: 'Based in', value: 'London'},
  {label: 'Timezone', value: 'GMT / BST'},
];

// For resolving ?about=<slug> in the browser, since the page itself is static.
const titles = Object.fromEntries((await getLibraryItems())
    .map(({data}) => [data.slug, data.title]));
---
<Layout
  title="Contact Me - Seán McNamara"
  description={DESCRIPTION}
  image={cardPath('contact')}
>
  <div class="page-wrap contact-page">
    <div class="contact-page__cols">
      <aside aria-label="Profile" class="rail rail--bio contact-bio">
        <span class="contact-bio__portrait">
          <Image
            alt="Seán McNamara"
            fetchpriority="high"
            loading="eager"
            src={avatar}
            width={400}
          />
        </span>

        <div>
          <div class="eyebrow">Contact</div>
          <div class="contact-bio__intro">
            <p class="contact-bio__blurb">
              Everything reaches me. Email is the surest route, but any of
              these work.
            </p>
            <span class="contact-bio__avatar-small">
              {/* Same size as the portrait, so it's the same cached file. */}
              <Image alt="" loading="eager" src={avatar} width={400} />
            </span>
          </div>
        </div>

        <div>
          {RAIL.map(row => (
            <div class="contact-bio__row">
              <span>{row.label}</span>
              <span class="contact-bio__value">{row.value}</span>
            </div>
          ))}
        </div>
      </aside>

      <div class="contact-page__main">
        <div class="sticky-bar contact-page__bar">
          <h1 class="contact-page__title">Let&apos;s talk</h1>
          <span class="contact-page__email">{EMAIL}</span>
        </div>

        <p class="contact-page__lead">
          A question about something I&apos;ve written, an idea you&apos;d like
          to collaborate on, or just a general hello. This is the best place to
          reach me. For roles and recruiting, LinkedIn is better.
        </p>

        <div class="contact-reply" hidden>
          <div>
            <div class="contact-reply__eyebrow">Replying about</div>
            <a class="contact-reply__title" href="/library/"></a>
            <div class="contact-reply__note">
              A link to this post will be included with your message.
            </div>
          </div>
          <button class="contact-reply__remove" type="button">Remove ✕</button>
        </div>

        <ContactForm email={EMAIL} />
      </div>

      <aside aria-label="Elsewhere" class="right-rail contact-elsewhere">
        <div class="rail-heading">Elsewhere</div>
        <ElsewhereLinks />
      </aside>
    </div>
  </div>
</Layout>

<script type="application/json" id="contact-titles" set:html={JSON.stringify(titles)} />

<script>
  /*
   * Articles end with "Get in touch about this", which arrives here as
   * ?about=<slug>. Resolving it to a title lets the form say what it is a
   * reply to, and passes the link along with the message.
   */
  const titles = JSON.parse(
      document.getElementById('contact-titles').textContent,
  );
  const slug = new URLSearchParams(window.location.search).get('about');
  const title = slug && titles[slug];
  const reply = document.querySelector('.contact-reply');
  const field = document.querySelector('.contact-form input[name="about"]');

  if (title) {
    const link = reply.querySelector('.contact-reply__title');
    link.href = `/library/${slug}/`;
    link.textContent = title;
    field.value = `${title} — /library/${slug}/`;
    field.disabled = false;
    reply.hidden = false;
  }

  reply.querySelector('.contact-reply__remove').addEventListener('click', () => {
    reply.hidden = true;
    field.disabled = true;
  });
</script>
