---
/*
 * Every tag at once, ranked by how much has been filed under it, with a bar so
 * the shape of the archive is legible before you read a single label.
 */
import Icon from '../../../components/icons/Icon.astro';
import Layout from '../../../layouts/Layout.astro';
import {getLibraryMeta} from '../../../lib/library.js';
import {slugToTitle, tagPath} from '../../../utils/content.js';
import '../../../styles/pages/tags.scss';

const BLURB = 'The tools, platforms and themes that run through the Library.';
const {tags} = await getLibraryMeta();
const maxCount = tags.length ? tags[0].count : 1;
---
<Layout
  title="Tags - Seán McNamara"
  description="The tools, platforms and themes that run through the library."
>
  <div class="page-wrap tags-page">
    <div class="tags-page__head" data-condense>
      <h1 class="tags-page__title">
        <Icon name="tag" size={19} style="color: var(--accent)" />
        Tags
      </h1>
      <p class="tags-page__blurb">{BLURB}</p>
    </div>

    <div class="sticky-bar tags-page__bar" data-condense>
      <a class="tags-page__back" href="/library/">
        <Icon name="arrowLeft" />
        Back to library
      </a>
      <span class="tags-page__sticky-title">{BLURB}</span>
      <span class="tags-page__count">
        <Icon name="tag" size={14} style="color: var(--accent)" />
        {tags.length} tags
      </span>
    </div>

    <div class="tags-page__grid">
      {tags.map(tag => (
        <a class="tags-page__row" href={tagPath(tag.name)}>
          <span class="tags-page__name">{slugToTitle(tag.name)}</span>
          <span class="tags-page__track">
            <span
              class:list={['tags-page__bar-fill', {'is-strong': tag.count >= 3}]}
              style={`width: ${Math.round((tag.count / maxCount) * 100)}%`}
            ></span>
          </span>
          <span class="tags-page__tally">{tag.count}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
