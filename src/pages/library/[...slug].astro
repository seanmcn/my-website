---
/*
 * A library item: post, note or find. One page per published entry, with the
 * related and series context worked out up front.
 */
import {Picture} from 'astro:assets';
import {getEntry, render} from 'astro:content';
import Icon from '../../components/icons/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import Prose from '../../components/Prose.astro';
import SeriesNavigator from '../../components/item/SeriesNavigator.astro';
import {MDX_COMPONENTS} from '../../components/mdx/index.js';
import {
  categoryPath,
  formatItemDate,
  itemPath,
  readTimeLabel,
  slugToTitle,
  sourceHost,
  typeMeta,
} from '../../utils/content.js';
import {IMAGE_SIZES} from '../../lib/image-sizes.js';
import {excerpt, getLibraryItems, itemContext} from '../../lib/library.js';
import '../../styles/pages/item.scss';

export async function getStaticPaths() {
  const items = await getLibraryItems();

  return items.map(item => ({
    params: {slug: item.data.slug},
    props: {item, context: itemContext(item, items)},
  }));
}

const TYPE_GLYPH = {post: '●', note: '◆', find: '■'};

const {item, context} = Astro.props;
const {data} = item;
const {Content, headings} = await render(item);

const type = data.type;
const meta = typeMeta(type);
const isFind = type === 'find';
const margins = data.margins;
const readTime = readTimeLabel(context.readingTime);
const host = sourceHost(data.source);
const toc = headings
    .filter(heading => heading.depth === 2)
    .map(heading => ({text: heading.text, href: `#${heading.slug}`}));
const showToc = toc.length > 2;
const title = `${data.title} - Seán McNamara`;

// The project this item is about, if it names one.
const project = data.project ? (await getEntry(data.project)).data : null;

const {relatedPosts} = context;
---
<Layout
  title={title}
  description={data.summary || excerpt(item)}
  type="article"
>
  <div class="page-wrap item-page" data-type={type}>
    <article class="item-page__article" id="postMainColumn">
      <div class="item-bar" data-condense>
        <a class="item-bar__back" href="/library/">
          <Icon name="arrowLeft" />
          <span class="item-bar__back-label">Library</span>
        </a>
        <h1 class="item-bar__title">{data.title}</h1>
        {!isFind && readTime && (
          <span class="item-bar__read-time"><Icon name="clock" />{readTime}</span>
        )}
        <span class="item-bar__date">
          <Icon name="calendar" />
          {formatItemDate(data.date)}
        </span>
      </div>

      <div class:list={[
        'item-page__body',
        {'item-page__body--narrow': isFind || type === 'note'},
      ]}>
        {!isFind && readTime && (
          <div class="item-page__read-time"><Icon name="clock" size={13} />{readTime}</div>
        )}

        {(showToc || margins.length > 0) && (
          <div class="item-page__top-meta">
            <div class="item-page__top-meta-grid">
              {showToc && (
                <div class="item-page__top-meta-toc">
                  <div class="rail-block__label">On this page</div>
                  {toc.map(heading => (
                    <a class="item-rail__toc-link" href={heading.href}>{heading.text}</a>
                  ))}
                </div>
              )}
              {margins.length > 0 && (
                <div class="item-page__top-meta-margins">
                  {margins.map(margin => (
                    <div>
                      <div class="item-page__margin-label">{margin.label}</div>
                      <p class="item-page__margin-text">{margin.text}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        {/*
          The series box comes before the featured image, so the image floats
          beside the post's opening text rather than beside the box.
        */}
        <SeriesNavigator currentSlug={data.slug} {...context} />

        {data.featured && (
          <figure class="prose__float-figure">
            {/*
              AVIF where the browser takes it, WebP otherwise. A PNG
              fallback would only serve browsers too old for WebP, at
              megabytes a file in every build.
            */}
            <Picture
              alt={data.title}
              class="featured-image"
              fallbackFormat="webp"
              fetchpriority="high"
              formats={['avif']}
              loading="eager"
              src={data.featured}
              width={720}
              {...IMAGE_SIZES.featured}
           />
          </figure>
        )}

        {isFind && data.source && (
          <a
            class="item-page__source"
            href={data.source}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="item-page__source-label">Source</span>
            <span class="item-page__source-link">
              {data.sourceTitle || host}
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        )}

        <Prose>
          <Content components={MDX_COMPONENTS} />
        </Prose>
      </div>

      <div class="item-page__end">
        {data.tags.length > 0 && (
          <div class="item-page__tags">
            {data.tags.map(tag => (
              <a class="item-page__tag" href={`/library/tags/${tag}/`}>
                <Icon name="tag" size={11} />
                {slugToTitle(tag)}
              </a>
            ))}
          </div>
        )}

        <div class="item-page__ornament">
          <span class="item-page__rule"></span>
          <span class="item-page__diamond"></span>
          <span class="item-page__rule"></span>
        </div>
        <div class="item-page__end-row">
          <span class="item-page__end-left">
            {data.category && (
              <a class="item-page__category-link" href={categoryPath(data.category)}>
                <Icon name="category" size={13} />
                {slugToTitle(data.category)}
              </a>
            )}
          </span>
          <span class="item-page__kind">
            <span
              class={`type-dot type-dot--${type}`}
              style={`background: ${meta.colour}`}
            ></span>
            {meta.label}
          </span>
          <span class="item-page__end-right">
            <a href={`/contact/?about=${data.slug}`}>
              <Icon name="reply" size={13} />
              Get in touch about this →
            </a>
          </span>
        </div>
      </div>
    </article>

    <aside class="item-rail" id="postSidebarColumn">
      {margins.length > 0 && (
        <div class="item-rail__margins">
          {margins.map(margin => (
            <div>
              <div class="rail-block__label">{margin.label}</div>
              <p class="item-rail__margin-text">{margin.text}</p>
            </div>
          ))}
        </div>
      )}

      {!isFind && readTime && (
        <div class="item-rail__read-time-block">
          <div class="rail-block__label">Read time</div>
          <div class="item-rail__read-time"><Icon name="clock" size={13} />{readTime}</div>
        </div>
      )}

      {isFind && host && (
        <div>
          <div class="rail-block__label">Source</div>
          <div class="item-rail__read-time">
            <a href={data.source} rel="noopener noreferrer" target="_blank">
              {host} ↗
            </a>
          </div>
        </div>
      )}

      {project && (
        <div class="rail-block">
          <div class="rail-block__label">The project</div>
          <a class="item-rail__project" href={`/projects/${project.slug}/`}>
            {project.featured && (
              <span class="item-rail__project-thumb">
                <Picture
                  alt=""
                  fallbackFormat="webp"
                  fit="cover"
                  formats={['avif']}
                  height={188}
                  position="top"
                  src={project.featured}
                  width={300}
                  {...IMAGE_SIZES.projectCard}
                />
              </span>
            )}
            <span class="item-rail__project-text">
              <span class="item-rail__project-title">{project.title}</span>
              <span class="item-rail__project-more">
                Screenshots and details →
              </span>
            </span>
          </a>
        </div>
      )}

      {showToc && (
        <div class="rail-block item-rail__toc-block">
          <div class="rail-block__label">On this page</div>
          {toc.map(heading => (
            <a class="item-rail__toc-link" href={heading.href}>{heading.text}</a>
          ))}
        </div>
      )}

      {relatedPosts.length > 0 && (
        <div class="rail-block">
          <div class="rail-block__label">Related</div>

          <div class="item-rail__related-list">
            {relatedPosts.map(related => (
              <a class="item-rail__related" href={itemPath(related.slug)}>
                <span
                  class="item-rail__glyph"
                  style={`color: ${typeMeta(related.type).colour}`}
                >
                  {TYPE_GLYPH[related.type]}
                </span>
                <span>{related.title}</span>
              </a>
            ))}
          </div>

          <div class="item-rail__related-grid">
            {relatedPosts.map(related => (
              <a class="item-rail__related-card" href={itemPath(related.slug)}>
                {related.featured ? (
                  <span class="item-rail__related-thumb">
                    <Picture
                      alt=""
                      fallbackFormat="webp"
                      fit="cover"
                      formats={['avif']}
                      height={260}
                      loading="lazy"
                      position="top"
                      src={related.featured}
                      width={260}
                      {...IMAGE_SIZES.related}
                    />
                  </span>
                ) : (
                  <span
                    class="item-rail__related-thumb item-rail__related-thumb--glyph"
                    style={`color: ${typeMeta(related.type).colour}`}
                  >
                    {TYPE_GLYPH[related.type]}
                  </span>
                )}
                <span class="item-rail__related-title">{related.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</Layout>

<script>
  import {followReadingProgress} from '../../scripts/rail-progress.js';

  followReadingProgress('.item-rail');
</script>
