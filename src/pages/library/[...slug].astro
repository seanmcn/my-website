---
/*
 * A library item: post, note or find. One page per published entry, with the
 * related and series context worked out up front.
 */
import {Picture, getImage} from 'astro:assets';
import {render} from 'astro:content';
import Icon from '../../components/icons/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import Prose from '../../components/Prose.astro';
import SeriesNavigator from '../../components/item/SeriesNavigator.astro';
import {MDX_COMPONENTS} from '../../components/mdx/index.js';
import {
  categoryPath,
  formatItemDate,
  itemPath,
  readTimeLabel,
  slugToTitle,
  sourceHost,
  typeMeta,
} from '../../utils/content.js';
import {excerpt, getLibraryItems, itemContext} from '../../lib/library.js';

export async function getStaticPaths() {
  const items = await getLibraryItems();

  return items.map(item => ({
    params: {slug: item.data.slug},
    props: {item, context: itemContext(item, items)},
  }));
}

const TYPE_GLYPH = {post: '●', note: '◆', find: '■'};

const {item, context} = Astro.props;
const {data} = item;
const {Content, headings} = await render(item);

const type = data.type;
const meta = typeMeta(type);
const isFind = type === 'find';
const margins = data.margins;
const readTime = readTimeLabel(context.readingTime);
const host = sourceHost(data.source);
const toc = headings
    .filter(heading => heading.depth === 2)
    .map(heading => ({text: heading.text, href: `#${heading.slug}`}));
const showToc = toc.length > 2;
const title = `${data.title} - Seán McNamara`;

const relatedPosts = await Promise.all(context.relatedPosts.map(
    async related => ({
      ...related,
      thumb: related.featured ?
        (await getImage({
          src: related.featured,
          width: 260,
          height: 260,
          fit: 'cover',
          position: 'top',
        })).src :
        '',
    }),
));
---
<Layout
  title={title}
  description={data.summary || excerpt(item)}
  type="article"
>
  <div class="pageWrap itemPage" data-type={type}>
    <article class="itemPage__article" id="postMainColumn">
      <div class="itemBar">
        <a class="itemBar__back" href="/library/">
          <Icon name="arrowLeft" />
          <span class="itemBar__backLabel">Library</span>
        </a>
        <h1 class="itemBar__title">{data.title}</h1>
        {!isFind && readTime && (
          <span class="itemBar__readTime"><Icon name="clock" />{readTime}</span>
        )}
        <span class="itemBar__date">
          <Icon name="calendar" />
          {formatItemDate(data.date)}
        </span>
      </div>

      <div class:list={[
        'itemPage__body',
        {'itemPage__body--narrow': isFind || type === 'note'},
      ]}>
        {!isFind && readTime && (
          <div class="itemPage__readTime"><Icon name="clock" size={13} />{readTime}</div>
        )}

        {(showToc || margins.length > 0) && (
          <div class="itemPage__topMeta">
            <div class="itemPage__topMetaGrid">
              {showToc && (
                <div class="itemPage__topMetaToc">
                  <div class="railBlock__label">On this page</div>
                  {toc.map(heading => (
                    <a class="itemRail__tocLink" href={heading.href}>{heading.text}</a>
                  ))}
                </div>
              )}
              {margins.length > 0 && (
                <div class="itemPage__topMetaMargins">
                  {margins.map(margin => (
                    <div>
                      <div class="itemPage__marginLabel">{margin.label}</div>
                      <p class="itemPage__marginText">{margin.text}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        {data.featured && (
          <figure class="prose__floatFigure">
            <Picture
              alt={data.title}
              class="featuredImage"
              formats={['avif', 'webp']}
              src={data.featured}
              width={720}
           />
          </figure>
        )}

        {isFind && data.source && (
          <a
            class="itemPage__source"
            href={data.source}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="itemPage__sourceLabel">Source</span>
            <span class="itemPage__sourceLink">
              {data.sourceTitle || host}
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        )}

        <SeriesNavigator currentSlug={data.slug} {...context} />

        <Prose>
          <Content components={MDX_COMPONENTS} />
        </Prose>
      </div>

      <div class="itemPage__end">
        {data.tags.length > 0 && (
          <div class="itemPage__tags">
            {data.tags.map(tag => (
              <a class="itemPage__tag" href={`/library/tags/${tag}/`}>
                <Icon name="tag" size={11} />
                {slugToTitle(tag)}
              </a>
            ))}
          </div>
        )}

        <div class="itemPage__ornament">
          <span class="itemPage__rule"></span>
          <span class="itemPage__diamond"></span>
          <span class="itemPage__rule"></span>
        </div>
        <div class="itemPage__endRow">
          <span class="itemPage__endLeft">
            {data.category && (
              <a class="itemPage__categoryLink" href={categoryPath(data.category)}>
                <Icon name="category" size={13} />
                {slugToTitle(data.category)}
              </a>
            )}
          </span>
          <span class="itemPage__kind">
            <span
              class={`typeDot typeDot--${type}`}
              style={`background: ${meta.colour}`}
            ></span>
            {meta.label}
          </span>
          <span class="itemPage__endRight">
            <a href={`/contact/?about=${data.slug}`}>
              <Icon name="reply" size={13} />
              Get in touch about this →
            </a>
          </span>
        </div>
      </div>
    </article>

    <aside class="itemRail" id="postSidebarColumn">
      {margins.length > 0 && (
        <div class="itemRail__margins">
          {margins.map(margin => (
            <div>
              <div class="railBlock__label">{margin.label}</div>
              <p class="itemRail__marginText">{margin.text}</p>
            </div>
          ))}
        </div>
      )}

      {!isFind && readTime && (
        <div class="itemRail__readTimeBlock">
          <div class="railBlock__label">Read time</div>
          <div class="itemRail__readTime"><Icon name="clock" size={13} />{readTime}</div>
        </div>
      )}

      {isFind && host && (
        <div>
          <div class="railBlock__label">Source</div>
          <div class="itemRail__readTime">
            <a href={data.source} rel="noopener noreferrer" target="_blank">
              {host} ↗
            </a>
          </div>
        </div>
      )}

      {showToc && (
        <div class="railBlock itemRail__tocBlock">
          <div class="railBlock__label">On this page</div>
          {toc.map(heading => (
            <a class="itemRail__tocLink" href={heading.href}>{heading.text}</a>
          ))}
        </div>
      )}

      {relatedPosts.length > 0 && (
        <div class="railBlock">
          <div class="railBlock__label">Related</div>

          <div class="itemRail__relatedList">
            {relatedPosts.map(related => (
              <a class="itemRail__related" href={itemPath(related.slug)}>
                <span
                  class="itemRail__glyph"
                  style={`color: ${typeMeta(related.type).colour}`}
                >
                  {TYPE_GLYPH[related.type]}
                </span>
                <span>{related.title}</span>
              </a>
            ))}
          </div>

          <div class="itemRail__relatedGrid">
            {relatedPosts.map(related => (
              <a class="itemRail__relatedCard" href={itemPath(related.slug)}>
                {related.thumb ? (
                  <span class="itemRail__relatedThumb">
                    <img alt="" loading="lazy" src={related.thumb} />
                  </span>
                ) : (
                  <span
                    class="itemRail__relatedThumb itemRail__relatedThumb--glyph"
                    style={`color: ${typeMeta(related.type).colour}`}
                  >
                    {TYPE_GLYPH[related.type]}
                  </span>
                )}
                <span class="itemRail__relatedTitle">{related.title}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</Layout>

<script>
  import {condenseOnScroll} from '../../scripts/condensed.js';

  condenseOnScroll('.itemBar');
</script>
