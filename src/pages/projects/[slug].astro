---
import {render} from 'astro:content';
import Icon from '../../components/icons/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import ProjectGallery from '../../components/project/ProjectGallery.astro';
import Prose from '../../components/Prose.astro';
import {
  excerpt,
  getItemsAboutProject,
  getProjects,
} from '../../lib/library.js';
import {formatItemDate, formatLongDate, itemPath} from '../../utils/content.js';

export async function getStaticPaths() {
  const projects = await getProjects();

  return Promise.all(projects.map(async project => ({
    params: {slug: project.data.slug},
    props: {
      project,
      writing: (await getItemsAboutProject(project.id)).map(({data}) => data),
      others: projects
          .filter(other => other.id !== project.id)
          .slice(0, 4)
          .map(({data}) => data),
    },
  })));
}

const {project, writing, others} = Astro.props;
const {data} = project;
const {Content} = await render(project);
---
<Layout
  title={`${data.title} - Projects - Seán McNamara`}
  description={data.summary || excerpt(project, 180)}
>
  <div class="page-wrap project-page">
    <article class="project-page__article">
      <div class="item-bar">
        <a class="item-bar__back" href="/projects/">
          <Icon name="arrowLeft" />
          Projects
        </a>
        <h1 class="item-bar__title">{data.title}</h1>
        <span class="item-bar__date">
          <Icon name="calendar" />
          {formatLongDate(data.date)}
        </span>
      </div>

      {data.summary && <p class="project-page__lead">{data.summary}</p>}

      <ProjectGallery
        featured={data.featured}
        gallery={data.gallery}
        title={data.title}
      />

      <div class="project-page__divider"></div>
      <Prose><Content /></Prose>
    </article>

    <aside class="right-rail project-rail">
      {data.repo && (
        <a
          class="project-rail__cta"
          href={data.repo}
          rel="noopener noreferrer"
          target="_blank"
        >
          View repository ↗
        </a>
      )}
      {data.demo && (
        <a
          class="project-rail__cta project-rail__cta--secondary"
          href={data.demo}
          rel="noopener noreferrer"
          target="_blank"
        >
          View website ↗
        </a>
      )}

      {writing.length > 0 && (
        <div>
          <div class="rail-block__label">Written about</div>
          {writing.map(item => (
            <a class="project-rail__writing" href={itemPath(item.slug)}>
              <span class="project-rail__writing-title">{item.title}</span>
              <span class="project-rail__writing-date">
                {formatItemDate(item.date)}
              </span>
            </a>
          ))}
        </div>
      )}

      <div class:list={{'rail-block': writing.length > 0}}>
        <div class="rail-block__label">Started</div>
        <div class="project-rail__value">{formatLongDate(data.date)}</div>
      </div>

      {data.techStack.length > 0 && (
        <div class="rail-block">
          <div class="rail-block__label">Tech stack</div>
          <div class="project-rail__chips">
            {data.techStack.map(item => <span class="project-rail__chip">{item}</span>)}
          </div>
        </div>
      )}

      {data.tags.length > 0 && (
        <div class="rail-block">
          <div class="rail-block__label">Tags</div>
          <div class="project-rail__chips">
            {data.tags.map(tag => <span class="project-rail__tag">#{tag}</span>)}
          </div>
        </div>
      )}

      {others.length > 0 && (
        <div class="rail-block">
          <div class="rail-block__label">Other projects</div>
          {others.map(other => (
            <a class="project-rail__other" href={`/projects/${other.slug}/`}>
              {other.title}{' '}
              <span class="project-rail__other-stack">{other.language}</span>
            </a>
          ))}
        </div>
      )}
    </aside>
  </div>
</Layout>

<script>
  import {condenseOnScroll} from '../../scripts/condensed.js';

  condenseOnScroll('.item-bar');
</script>
