---
/*
 * The two profiles worth following, shown by both the about and contact
 * pages. Styling sits with the other shared scaffolds in layout.scss.
 */
import Icon from '../icons/Icon.astro';
---
<div class="elsewhereLinks">
  <a
    class="elsewhereLink"
    href="https://www.linkedin.com/in/mrseanmcn"
    rel="noopener noreferrer"
    target="_blank"
  >
    <Icon name="linkedin" size={14} />
    LinkedIn
    <span aria-hidden="true" class="elsewhereLink__arrow">↗</span>
  </a>
  <a
    class="elsewhereLink"
    href="https://github.com/seanmcn"
    rel="noopener noreferrer"
    target="_blank"
  >
    <Icon name="github" size={14} />
    GitHub
    <span aria-hidden="true" class="elsewhereLink__arrow">↗</span>
  </a>
</div>
