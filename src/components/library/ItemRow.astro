---
/*
 * One row in any listing. The thumbnail column always carries a coloured
 * spine in the item's type colour; where there is no image the space is filled
 * with a hatched plate rather than left blank, so a column of notes and finds
 * still reads as a column.
 */
import Icon from '../icons/Icon.astro';
import {Image} from 'astro:assets';
import {
  formatItemDate,
  itemPath,
  readTimeLabel,
  slugToTitle,
  sourceHost,
  typeMeta,
} from '../../utils/content.js';
import {excerpt, readingTimeMinutes} from '../../lib/library.js';

// Rows near the top of a listing load straight away; the rest wait to scroll.
const {eager = false, item} = Astro.props;
const {data} = item;
const type = data.type;
const meta = typeMeta(type);
const isFind = type === 'find';
const readTime = readTimeLabel(readingTimeMinutes(item.body));
const summary = data.summary || excerpt(item, 190);
const host = sourceHost(data.source);
---
<a class="item-row" data-type={type} href={itemPath(data.slug)}>
  <span class="item-row__thumb-col">
    <span class="item-row__spine" style={`background: ${meta.colour}`}></span>
    {data.featured ? (
      <span class="item-row__thumb">
        <Image
          alt=""
          fit="cover"
          height={260}
          loading={eager ? 'eager' : 'lazy'}
          position="top"
          src={data.featured}
          width={260}
       />
      </span>
    ) : (
      <span class={`item-row__plate item-row__plate--${type}`}>
        <span class="item-row__plate-note">
          {isFind ? host || 'Link' : 'No image'}
        </span>
      </span>
    )}
    <span class="item-row__pill" style={`background: ${meta.colour}`}>
      {meta.label}
    </span>
  </span>

  {isFind ? (
    host && (
      <span class="item-row__category item-row__category--source">{host}</span>
    )
  ) : (
    data.category && (
      <span class="item-row__category">
        <Icon name="category" />
        {slugToTitle(data.category)}
      </span>
    )
  )}

  <span class="item-row__title">{data.title}</span>
  <span class="item-row__excerpt">{summary}</span>
  <span class="item-row__date">{formatItemDate(data.date)}</span>

  {isFind ? (
    <span class="item-row__time">Link ↗</span>
  ) : (
    readTime && (
      <span class="item-row__time">
        <Icon name="clock" size={11} />
        {readTime.replace(' read', '')}
      </span>
    )
  )}
</a>
