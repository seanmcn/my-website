---
/*
 * The All / Posts / Notes / Finds bar. Each filter is a real route rather than
 * client state, so a filtered library is linkable and gets its own pagination.
 */
import {getLibraryMeta} from '../../lib/library.js';
import {LIBRARY_FILTERS} from '../../utils/content.js';

const {active = 'all', resultLine = ''} = Astro.props;
const {counts} = await getLibraryMeta();
const DOT = {post: 'plum', note: 'amber', find: 'blue'};
---
<div class="stickyBar libraryFilters">
  {LIBRARY_FILTERS.map(filter => (
    <a
      class:list={['libraryFilters__link', {'is-active': active === filter.key}]}
      href={filter.path}
    >
      {filter.key !== 'all' && (
        <span
          class={`libraryFilters__dot libraryFilters__dot--${filter.key}`}
          style={`background: var(--${DOT[filter.key]})`}
        ></span>
      )}
      {filter.label}
      <span class="libraryFilters__count">{counts[filter.key] || 0}</span>
    </a>
  ))}
  {resultLine && <span class="libraryFilters__results">{resultLine}</span>}
</div>
