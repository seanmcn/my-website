---
/*
 * The library index, its per-type views and both taxonomy listings are the
 * same screen with a different rail selection and a different set of rows, so
 * they share one component. `page` comes from paginate() in lib/library.js.
 */
import ItemRow from './ItemRow.astro';
import LibraryFilters from './LibraryFilters.astro';
import LibraryPagination from './LibraryPagination.astro';
import LibraryRail from './LibraryRail.astro';

const {
  activeCategory = null,
  activeFilter = 'all',
  activeTag = null,
  blurb = '',
  page,
  title,
} = Astro.props;
const count = page.totalCount;
const resultLine = `${count} ${count === 1 ? 'item' : 'items'}`;
// About this many rows show on a laptop screen before scrolling; their
// thumbnails load straight away rather than lazily.
const ABOVE_THE_FOLD = 4;
---
<div class="page-wrap">
  <!--
    Every library view names itself in the rail and the filter bar rather than
    in a page title, so the h1 is held for assistive tech only.
  -->
  <h1 class="visually-hidden">{title}</h1>
  <div class="two-col two-col--padded">
    <div class="mobile-intro">
      <div class="library-rail__eyebrow">{title} &middot; {count}</div>
      <p>{blurb}</p>
    </div>
    <button aria-expanded="false" class="rail-toggle" type="button">
      Filters ▾
    </button>

    <LibraryRail
      activeCategory={activeCategory}
      activeTag={activeTag}
      blurb={blurb}
      count={count}
      title={title}
    />

    <div>
      <LibraryFilters active={activeFilter} resultLine={resultLine} />

      {page.items.map((item, index) => (
        <ItemRow eager={index < ABOVE_THE_FOLD} item={item} />
      ))}

      {page.items.length === 0 && (
        <div class="library-empty">
          <div class="library-empty__title">Nothing here yet</div>
          <p class="library-empty__body">
            No items match that combination of filters.
          </p>
          <a class="library-empty__action" href="/library/">Clear filters ✕</a>
        </div>
      )}

      {page.items.length > 0 && <LibraryPagination page={page} />}
    </div>
  </div>
</div>

<script>
  import {bindRailToggle} from '../../scripts/rail-toggle.js';

  bindRailToggle();
</script>
