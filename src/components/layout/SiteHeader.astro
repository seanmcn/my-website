---
/*
 * SiteHeader and MobileMenu from the Gatsby site, rendered once at build
 * time. Active links come from the URL here rather than reach-router, and the
 * menu, theme and search behaviour lives in two small scripts, so the header
 * ships no framework runtime at all.
 */
import {Image} from 'astro:assets';
import beer from '../../assets/images/emojis/250/beer.png';
import cheer from '../../assets/images/emojis/250/cheer.png';
import santa from '../../assets/images/emojis/250/santa.png';
import thumbsUp from '../../assets/images/emojis/250/thumbs-up.png';

/*
 * The header avatar changes on every page. All of them are in the markup and
 * load eagerly, so after the first page each one comes from the cache and the
 * switch never waits on the network. The index's big bio avatar stays the wave.
 * Santa joins the mix from 15 to 25 December, so he comes last and isn't
 * counted in the everyday set.
 */
const AVATARS = [beer, cheer, thumbsUp];
const FESTIVE_AVATAR = santa;

const NAV_LINKS = [
  {label: 'Index', to: '/', match: pathname => pathname === '/'},
  {label: 'Library', to: '/library/', match: p => p.startsWith('/library')},
  {label: 'Projects', to: '/projects/', match: p => p.startsWith('/projects')},
  {label: 'About', to: '/about/', match: p => p.startsWith('/about')},
  {label: 'Contact', to: '/contact/', match: p => p.startsWith('/contact')},
];

const {pathname} = Astro.url;
---
<header class="site-header">
  <div class="site-header__inner shell">
    <a class="site-header__logo" href="/">
      <span class="site-header__avatar" data-avatar-count={AVATARS.length}>
        {/*
          Runs as the parser reaches it, before the images below exist, so
          the CSS shows the right one from the first paint. It never repeats
          the avatar of the page just left. Without JS the first one shows.
          The date is the visitor's own, since the site is built ahead of time.
        */}
        <script is:inline>
          (function() {
            var avatar = document.currentScript.parentElement;
            var now = new Date();
            var festive = now.getMonth() === 11 &&
              now.getDate() >= 15 && now.getDate() <= 25;
            var count = Number(avatar.dataset.avatarCount) + (festive ? 1 : 0);
            var storageKey = 'site-header-avatar';
            var last = 0;

            try {
              last = Number(window.sessionStorage.getItem(storageKey)) || 0;
            } catch (error) {}
            if (last > count) {
              last = 0;
            }

            var pick = 1 + Math.floor(Math.random() * (last ? count - 1 : count));
            if (last && pick >= last) {
              pick += 1;
            }
            avatar.dataset.avatar = String(pick);

            try {
              window.sessionStorage.setItem(storageKey, String(pick));
            } catch (error) {}
          })();
        </script>
        {[...AVATARS, FESTIVE_AVATAR].map(src => (
          <Image
            alt=""
            decoding="sync"
            height={128}
            loading="eager"
            src={src}
            width={128}
          />
        ))}
      </span>
      <span>
        <span class="site-header__wordmark">Seán McNamara</span>
        <span class="site-header__tagline">
          Software engineering &amp; other rabbit holes
        </span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      {NAV_LINKS.map(link => (
        <a
          class:list={['site-header__nav-link', {'is-active': link.match(pathname)}]}
          href={link.to}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <button
      aria-expanded="false"
      aria-label="Menu"
      class="site-header__burger"
      type="button"
    >
      ☰
    </button>

    <button aria-label="Switch to dark mode" class="theme-toggle" type="button">
      <span aria-hidden="true">◐</span>
    </button>

    <a aria-label="Search" class="site-header__search" href="/search/">
      <span aria-hidden="true" class="site-header__search-glyph">⌕</span>
      <span class="site-header__search-label">Search</span>
      <span aria-hidden="true" class="site-header__shortcut">/</span>
    </a>
  </div>
</header>

<div class="mobile-menu" role="dialog" aria-label="Menu" hidden>
  <div class="mobile-menu__head">
    <span class="mobile-menu__eyebrow">Menu</span>
    <button aria-label="Close menu" class="mobile-menu__close" type="button">
      ✕
    </button>
  </div>

  <nav class="mobile-menu__nav">
    {NAV_LINKS.map(link => (
      <a
        class:list={['mobile-menu__link', {'is-active': link.match(pathname)}]}
        href={link.to}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <div class="mobile-menu__actions">
    <a class="mobile-menu__search" href="/search/">
      <span aria-hidden="true">⌕</span>
      Search
    </a>
    <button class="mobile-menu__theme" type="button">
      <span aria-hidden="true">◐</span>Dark</button>
  </div>
</div>

<script>
  import '../../scripts/theme.js';
  import '../../scripts/header.js';
</script>
