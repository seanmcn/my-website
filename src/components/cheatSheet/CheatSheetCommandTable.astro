---
/*
 * A cheat sheet's commands as a table with a filter box. Every row is in the
 * page; the script takes out the rows where no cell contains the filter
 * text, so the table's striping still alternates.
 */
import Icon from '../icons/Icon.astro';
import './cheatSheetCommandTable.scss';

const {columns, data} = Astro.props;
---
<div class="cheat-sheet" data-cheat-sheet>
  <div class="table-container">
    <table class="table is-striped is-fullwidth is-hoverable is-bordered super-responsive-table">
      <thead>
        <tr>
          <th colspan={columns.length} style="text-align: left;">
            <div class="control has-icons-right">
              <input
                class="input is-medium"
                data-filter
                placeholder={`Search ${data.length} commands...`}
              />
              <span class="icon is-right">
                <Icon name="search" size={14} />
              </span>
            </div>
          </th>
        </tr>
        <tr>
          {columns.map(column => <th>{column.Header}</th>)}
        </tr>
      </thead>
      <tbody>
        {data.map(row => (
          <tr>
            {columns.map((column, index) => (
              <td>
                {index === 0 ?
                  <code>{row[column.accessor]}</code> :
                  row[column.accessor]}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div data-empty hidden>No results found!</div>
</div>

<script>
  document.querySelectorAll('[data-cheat-sheet]').forEach((sheet) => {
    const input = sheet.querySelector('[data-filter]');
    const body = sheet.querySelector('tbody');
    const rows = [...body.rows];
    const empty = sheet.querySelector('[data-empty]');

    input.addEventListener('input', () => {
      const query = input.value.toLowerCase();
      const shown = rows.filter(row => [...row.cells].some(
          cell => cell.textContent.toLowerCase().includes(query),
      ));

      body.replaceChildren(...shown);
      empty.hidden = shown.length > 0;
    });
  });
</script>
