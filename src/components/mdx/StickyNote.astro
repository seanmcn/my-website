---
/*
 * components/stickyNote/stickyNote.js. The data-* attributes let a
 * StickyStack around it rebuild the note in the browser, since an Astro
 * component can't read its children's props the way React could.
 */
const TILTS = [1.6, -1.6, 2.2, -2.2];
const {color = 'amber', label = 'Note', marker, tilt = TILTS[0]} = Astro.props;
---
<aside
  class={`stickyNote stickyNote--${color}`}
  id={marker ? `sticky-${marker}` : undefined}
  style={`--stickyTilt: ${tilt}deg`}
  data-color={color}
  data-label={label}
  data-marker={marker}
>
  <span aria-hidden="true" class="stickyNote__paper"></span>
  <span aria-hidden="true" class="stickyNote__tape"></span>
  <div class="stickyNote__content">
    <div class="stickyNote__label">
      {marker && <span class="stickyNote__marker">{marker}</span>}
      {label}
    </div>
    <div class="stickyNote__text"><slot /></div>
  </div>
</aside>
